{
  "id": "tesla_radar",
  "name": "Tesla Radar (OEM / ARS408)",
  "version": "1.1.2",
  "api": 1,
  "use": "onroad",
  "category": "data_source",
  "entry": "plugin:TeslaRadar",
  "author": "xpilot",
  "description": "Selects the factory Tesla radar, a Continental ARS408 object list on bus 1, or no radar. Factory radar is the default. Read only: it parses radar CAN and publishes radarTracks, it never sends frames.",
  "priority": 100,
  "enable_param": "XpilotTeslaRadar",
  "claims": [
    "source:radar"
  ],
  "settings": [
    {
      "key": "XpilotTeslaRadarBackend",
      "label": "Radar mode",
      "choices": [
        ["Factory radar", 0],
        ["ARS408 radar", 1],
        ["Radar off", 2]
      ]
    }
  ],
  "params": {
    "XpilotTeslaRadar": {
      "type": "BOOL",
      "default": "0"
    },
    "XpilotTeslaRadarBackend": {
      "type": "INT",
      "default": "0"
    }
  },
  "requires": {
    "hooks": [
      "radar_interface"
    ]
  }
}
