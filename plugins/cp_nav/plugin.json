{
  "id": "cp_nav",
  "name": "CP Native Navigation",
  "version": "0.2.4",
  "api": 1,
  "category": "navigation",
  "entry": "plugin:CPNav",
  "author": "Sniper-Eon",
  "description": "Independent CP v2 native Carrot navigation candidate. Separate settings, bounded lamp preparation and cruise targets; passing requires qualified side observations. No camera streaming.",
  "priority": 100,
  "enable_param": "ExtCpNavEnabled",
  "claims": [
    "process:cp_navd",
    "source:route",
    "role:lane_change.policy",
    "can.tx:0x3E9:1",
    "long.target",
    "alert",
    "msg:cp.state",
    "msg:lanes.intent",
    "msg:oem.lanes",
    "source:turnsignals"
  ],
  "settings": [
    {
      "key": "ExtCpNavSignals",
      "label": "CP physical turn signals"
    },
    {
      "key": "ExtCpNavLaneChanges",
      "label": "CP navigation lane changes"
    },
    {
      "key": "ExtCpNavSpeedControl",
      "label": "CP navigation speed control"
    },
    {
      "key": "ExtCpNavSpeedRaise",
      "label": "CP intelligent speed increase"
    },
    {
      "key": "ExtCpNavOvertakeMode",
      "label": "CP passing mode",
      "choices": [
        [
          "Off",
          0
        ],
        [
          "Suggest only",
          1
        ],
        [
          "Automatic requests",
          2
        ]
      ]
    },
    {
      "key": "ExtCpNavDrivingStyle",
      "label": "CP driving style",
      "choices": [
        [
          "Conservative",
          0
        ],
        [
          "Standard",
          1
        ],
        [
          "Aggressive",
          2
        ]
      ]
    },
    {
      "key": "ExtCpNavAutoTurn",
      "label": "CP native turn control",
      "choices": [
        [
          "Off",
          0
        ],
        [
          "Signals only",
          1
        ],
        [
          "Signals and slowdown",
          2
        ],
        [
          "Slowdown only",
          3
        ]
      ]
    },
    {
      "key": "ExtCpNavTurnKph",
      "label": "CP turn target speed",
      "range": [
        10,
        40,
        1,
        "km/h",
        1
      ]
    },
    {
      "key": "ExtCpNavTurnEndS",
      "label": "CP turn end lead",
      "range": [
        1,
        15,
        1,
        "s",
        1
      ]
    },
    {
      "key": "ExtCpNavDecelCms2",
      "label": "CP navigation deceleration",
      "range": [
        50,
        250,
        1,
        "cm/s2",
        1
      ]
    },
    {
      "key": "ExtCpNavSpeedFactorPct",
      "label": "CP speed safety factor",
      "range": [
        80,
        110,
        1,
        "%",
        1
      ]
    },
    {
      "key": "ExtCpNavRoadOffsetKph",
      "label": "CP road limit offset",
      "range": [
        -20,
        20,
        1,
        "km/h",
        1
      ]
    },
    {
      "key": "ExtCpNavSpeedEndS",
      "label": "CP speed control end lead",
      "range": [
        1,
        15,
        1,
        "s",
        1
      ]
    },
    {
      "key": "ExtCpNavBumpKph",
      "label": "CP speed bump target",
      "range": [
        10,
        50,
        1,
        "km/h",
        1
      ]
    },
    {
      "key": "ExtCpNavBumpTimeS",
      "label": "CP speed bump lead",
      "range": [
        1,
        10,
        1,
        "s",
        1
      ]
    },
    {
      "key": "ExtCpNavRearHoldM",
      "label": "CP rear camera hold distance",
      "range": [
        0,
        500,
        1,
        "m",
        1
      ]
    },
    {
      "key": "ExtCpNavMaxKph",
      "label": "CP maximum target speed",
      "range": [
        30,
        140,
        1,
        "km/h",
        1
      ]
    },
    {
      "key": "ExtCpNavRaiseStepKph",
      "label": "CP speed increase step",
      "range": [
        1,
        10,
        1,
        "km/h",
        1
      ]
    },
    {
      "key": "ExtCpNavRaiseIntervalS",
      "label": "CP speed increase interval",
      "range": [
        3,
        30,
        1,
        "s",
        1
      ]
    },
    {
      "key": "ExtCpNavLaneDelayMs",
      "label": "CP lane preparation delay",
      "range": [
        500,
        5000,
        100,
        "ms",
        1
      ]
    },
    {
      "key": "ExtCpNavOvertakeMinKph",
      "label": "CP minimum passing speed",
      "range": [
        70,
        120,
        1,
        "km/h",
        1
      ]
    },
    {
      "key": "ExtCpNavBeep",
      "label": "CP turn signal chime"
    }
  ],
  "params": {
    "ExtCpNavEnabled": {
      "type": "BOOL",
