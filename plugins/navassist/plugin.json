{
  "id": "navassist",
  "name": "Navigation Assist (phone)",
  "version": "2.4.5-final",
  "api": 1,
  "category": "navigation",
  "entry": "plugin:NavAssist",
  "author": "Sniper-Eon",
  "description": "TesNav v3 navigation with integrated lane positioning, bounded physical signals, maneuver slowdown and chime. CP native navigation is a separate mutually exclusive plugin.",
  "priority": 100,
  "enable_param": "ExtNavAssistEnabled",
  "claims": [
    "process:navassistd",
    "msg:nav.state",
    "msg:lanes.topology",
    "msg:lanes.intent",
    "msg:oem.lanes",
    "long.target",
    "role:lane_change.policy",
    "can.tx:0x3E9:1",
    "alert",
    "source:route",
    "msg:nav.route",
    "source:turnsignals",
    "sound",
    "msg:nav.map",
    "msg:nav.lamp"
  ],
  "settings": [
    {
      "key": "ExtNavAssistLaneChange",
      "label": "Navigation lane positioning"
    },
    {
      "key": "ExtNavAssistTurnSignal",
      "label": "Physical turn signal"
    },
    {
      "key": "ExtNavAssistTurnSlowdown",
      "label": "Maneuver speed ceiling"
    },
    {
      "key": "ExtNavAssistLookahead",
      "label": "Turn lane lookahead",
      "range": [
        100,
        1500,
        50,
        "m",
        1
      ]
    },
    {
      "key": "ExtNavAssistExitLookahead",
      "label": "Exit/ramp lookahead",
      "range": [
        300,
        3000,
        100,
        "m",
        1
      ]
    },
    {
      "key": "ExtNavAssistSignalLead",
      "label": "Turn signal lead",
      "range": [
        3,
        12,
        1,
        "s",
        1
      ]
    },
    {
      "key": "ExtNavAssistTurnSpeed",
      "label": "Turn target speed",
      "range": [
        10,
        30,
        1,
        "km/h",
        1
      ]
    },
    {
      "key": "ExtNavAssistMaxChanges",
      "label": "Lane changes per maneuver",
      "range": [
        1,
        5,
        1,
        "",
        1
      ]
    },
    {
      "key": "ExtNavAssistPairingReset",
      "label": "Reset phone pairing (parked)"
    },
    {
      "key": "ExtNavAssistPhoneBlindspot",
      "label": "Phone blind spot extra veto"
    },
    {
      "key": "ExtNavAssistBeep",
      "label": "Navigation lane-change chime"
    },
    {
      "key": "ExtNavAssistPhoneLane",
      "label": "Phone lane model observation"
    }
  ],
  "params": {
    "ExtNavAssistEnabled": {
      "type": "BOOL",
      "default": "0"
    },
    "ExtNavAssistLaneChange": {
      "type": "BOOL",
      "default": "0"
    },
    "ExtNavAssistTurnSignal": {
      "type": "BOOL",
      "default": "0"
    },
    "ExtNavAssistTurnSlowdown": {
      "type": "BOOL",
      "default": "1"
    },
    "ExtNavAssistLookahead": {
      "type": "INT",
      "default": "1000",
      "note": "metres before an ordinary turn to align lanes"
    },
    "ExtNavAssistExitLookahead": {
      "type": "INT",
      "default": "2000",
      "note": "metres before an exit/ramp/merge"
    },
    "ExtNavAssistSignalLead": {
      "type": "INT",
      "default": "8",
      "note": "seconds of lead time for the pre-turn lamp"
    },
    "ExtNavAssistTurnSpeed": {
      "type": "INT",
      "default": "18",
      "note": "km/h target for ordinary left/right turns"
    },
    "ExtNavAssistMaxChanges": {
      "type": "INT",
      "default": "5",
      "note": "completed lane changes allowed per maneuver event"
    },
    "ExtNavAssistPairedApps": {
      "type": "JSON",
      "default": "null",
      "note": "Private paired app identities, stored outside driving logs"
    },
    "ExtNavAssistDevicePrivateKey": {
      "type": "STRING",
      "note": "Private P-256 device identity; never log or publish"
    },
    "ExtNavAssistPairingReset": {
      "type": "BOOL",
      "default": "0"
    },
    "ExtNavAssistPhoneBlindspot": {
      "type": "BOOL",
      "default": "0"
    },
    "ExtNavAssistBeep": {
      "type": "BOOL",
      "default": "1"
    },
    "ExtNavAssistSource": {
      "type": "INT",
      "default": "0",
      "note": "Retired shared-source selector; retained for rollback only. This version always uses TesNav; select the separate CP plugin for CP navigation."
    },
    "ExtNavAssistPhoneLane": {
      "type": "BOOL",
      "default": "0"
    }
  },
  "rules": [
    {
      "type": "template_clone.v2",
      "tx_address": 1001,
      "rx_address": 1001,
      "tx_bus": 1,
      "rx_bus": 1,
      "tx_length": 8,
      "rx_length": 8,
      "template_ttl_us": 1500000,
      "min_interval_us": 100000,
      "session": 2,
      "max_count": 200,
      "idle_reset_us": 0,
      "window_us": 60000000,
      "counter": {
        "kind": 1,
        "bit_offset": 52,
        "width": 4
      },
      "tx_checksum": {
        "kind": 1,
        "checksum_byte": 7
      },
      "rx_checksum": {
        "kind": 1,
        "checksum_byte": 7
      },
      "predicate_mask": [
        0,
        3,
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "predicate_value": [
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "copy_mask": [
        255,
        252,
        225,
        255,
        255,
        255,
        15,
        0
      ],
      "constant_mask": [
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "constant_value": [
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "fields": [
        {
          "bit_offset": 8,
          "width": 2,
          "min": 1,
          "max": 3,
          "exempt_values": [
            3
          ]
        },
        {
          "bit_offset": 17,
          "width": 4,
          "min": 4,
          "max": 8,
          "exempt_values": [
            4
          ]
        }
      ],
      "legal_tuples": [
        {
          "field_mask": 3,
          "values": [
            1,
            8
          ]
        },
        {
          "field_mask": 3,
          "values": [
            2,
            8
          ]
        },
        {
          "field_mask": 3,
          "values": [
            3,
            4
          ]
        }
      ],
      "engagement": "primary_or_lateral"
    }
  ],
  "requires": {
    "rule_abi": 2,
    "hooks": [
      "observe_can",
      "control_sends",
      "buzzer_policy"
    ]
  },
  "use": "both"
}
